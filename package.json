{
  "name": "unipress",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "build:vercel": "payload migrate && next build",
    "dev": "next dev",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "lint": "eslint .",
    "migrate": "payload migrate",
    "payload": "payload",
    "seed": "tsx src/scripts/seed-demo.ts",
